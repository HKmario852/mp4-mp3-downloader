<Window x:Class="Omni.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:System="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:Omni.Windows" Title="全能影音下載器" Icon="/App;component/Assets/omni.ico" Width="1440" Height="940" MinWidth="860" MinHeight="700" Background="#111923" Foreground="#EDF2FF" FontFamily="Microsoft JhengHei UI" FontSize="15" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6130FF"/><GradientStop Color="#168FFF" Offset="1"/></LinearGradientBrush>
  <local:QualityLabelConverter x:Key="QualityLabel"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Background" Value="#222F40"/><Setter Property="BorderBrush" Value="#34465B"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#17222F"/><Setter Property="Foreground" Value="#EDF2FF"/><Setter Property="BorderBrush" Value="#36495F"/><Setter Property="Padding" Value="12"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Margin" Value="3,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="3,8"/><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="#EDF2FF"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding Converter={StaticResource QualityLabel}}" Foreground="#EDF2FF"/></DataTemplate></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#17222F" BorderBrush="#36495F" BorderThickness="1" CornerRadius="6" MinHeight="45"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,9,30,9" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#91A5C2" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"><Border Background="#203044" BorderBrush="#36495F" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="320"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EDF2FF"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#35446B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="3,10"/><Setter Property="Foreground" Value="#D6E2F6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEFF"/><Setter Property="RowBackground" Value="#18222D"/><Setter Property="AlternatingRowBackground" Value="#1C2835"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#29394B"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="64"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="SelectionMode" Value="Extended"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202D3B"/><Setter Property="Foreground" Value="#9FB0C9"/><Setter Property="Padding" Value="10,12"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEFF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="8"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F0F3FF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="#E6EEFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderThickness="0,1" BorderBrush="Transparent"><DataGridCellsPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#222E44"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="#273554"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="#3E4E79"/><Setter Property="Foreground" Value="#F0F3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SlimScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="1,3" Background="#53647C" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#18222D"/><Setter Property="BorderBrush" Value="#2C4056"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="5"/></Style>
 </Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="14,2"><Image Source="/App;component/Assets/brand.png" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="全能影音下載器圖示"/><TextBlock Text="全能影音下載器" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="　OMNI / 0.1.4" Foreground="#7186A4" FontSize="11" VerticalAlignment="Center"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="380"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Panel}" Padding="9"><DockPanel><StackPanel x:Name="NavFooter" DockPanel.Dock="Bottom" Margin="12"><TextBlock Text="你的媒體，井然有序" Foreground="#8DA3C0" FontSize="12"/><TextBlock x:Name="SpaceLabel" Text="" Foreground="#C8D5EA" Margin="0,12,0,0"/></StackPanel><StackPanel><Button x:Name="NewNav" Content="＋　新增下載" Background="{StaticResource Accent}" Click="NewClick"/><Button x:Name="QueueNav" Content="↓　下載中" Background="Transparent" Click="QueueClick" Margin="3,15,3,3"/><Button x:Name="HistoryNav" Content="✓　已下載" Background="Transparent" Click="HistoryClick"/><Button x:Name="TagsNav" Content="♫　標籤編輯" Background="Transparent" Click="TagsClick"/><Button x:Name="SettingsNav" Content="⚙　設定" Background="Transparent" Click="SettingsClick"/><Button x:Name="CollapseNav" Content="☰" Background="Transparent" Click="CollapseClick"/></StackPanel></DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="12" MinHeight="94"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="UrlBox" Text="" MinHeight="56" MaxHeight="140" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" TextChanged="UrlChanged" AutomationProperties.Name="貼上影片連結" ToolTip="貼上 HTTPS 影片連結"/><Button Grid.Column="1" Content="分析連結" Background="{StaticResource Accent}" Click="AnalyzeClick"/></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock x:Name="PageTitle" Text="下載任務" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Foreground="#9FB4D0" Margin="12,5"/></DockPanel>
     <DockPanel Grid.Row="1" Margin="0,10"><Button DockPanel.Dock="Right" x:Name="ClearButton" Content="清空歷史" Click="ClearClick" Visibility="Collapsed"/><ComboBox x:Name="FormatFilter" DockPanel.Dock="Left" Width="135" SelectedIndex="0" SelectionChanged="FilterChanged" Visibility="Collapsed" AutomationProperties.Name="已下載格式篩選"><System:String>全部格式</System:String><System:String>MP3</System:String><System:String>MP4</System:String></ComboBox><TextBox x:Name="SearchBox" TextChanged="SearchChanged" Visibility="Collapsed" AutomationProperties.Name="搜尋標題、網址、檔名、歌手、專輯"/></DockPanel>
     <Grid Grid.Row="2"><DataGrid x:Name="JobGrid" SelectionChanged="SelectionChanged" MouseDoubleClick="FileDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="標題" Binding="{Binding Title}" Width="*" MinWidth="140"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="65"/><DataGridTextColumn Header="畫質 / 音質" Binding="{Binding Quality}" Width="100"/><DataGridTemplateColumn Header="狀態" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="#6A95FF"/><ProgressBar Value="{Binding Progress}" Height="4" Maximum="100" Margin="0,8,12,0" Foreground="#735DFF" Background="#304360"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="56" Foreground="#566C92" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="將喜歡的影音收藏到這裡" FontSize="21" Margin="0,15,0,8" HorizontalAlignment="Center"/><TextBlock Text="貼上連結，選擇格式，即可開始下載" Foreground="#879CB9" HorizontalAlignment="Center"/></StackPanel></Grid>
     <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="⏸ 暫停" Click="PauseClick"/><Button Content="▶ 繼續" Click="ResumeClick"/><Button Content="移除" Click="CancelClick"/><Button x:Name="FailedButton" Content="失敗任務" Click="FailedClick"/><Button x:Name="DeleteFileButton" Content="刪除所選檔案" Click="DeleteFileClick" Visibility="Collapsed"/><Button x:Name="EditTagsButton" Content="編輯所選標籤" Click="EditTagsClick"/><Button x:Name="FolderButton" Content="開啟檔案位置" Click="FolderClick"/><Button Content="診斷" Click="ErrorClick"/></WrapPanel>
    </Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" x:Name="GroupsPanel" MaxHeight="220" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GroupCards"/></ScrollViewer></Border>
    <Border Grid.Row="3" Style="{StaticResource Panel}" x:Name="RecentPanel"><StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="查看全部 ›" Click="HistoryClick" Background="Transparent" BorderBrush="Transparent" Padding="3"/><TextBlock Text="最近下載" FontSize="20" FontWeight="SemiBold"/></DockPanel><DataGrid x:Name="RecentGrid" Height="175" RowHeight="44" SelectionChanged="RecentSelected" MouseDoubleClick="FileDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="標題" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="70"/><DataGridTextColumn Header="畫質 / 音質" Binding="{Binding Quality}" Width="110"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="95"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   </Grid>
   <Border Grid.Column="2" x:Name="Details" Style="{StaticResource Panel}" Padding="0"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ScrollViewer.Resources><StackPanel Margin="20,18,16,16"><TextBlock Text="下載設定" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/><Border Height="192" Background="#111923" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock Text="▶" FontSize="50" Foreground="#778DF0" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Thumbnail" Stretch="Uniform"/></Grid></Border><TextBlock x:Name="MediaTitle" Text="準備好下一段精彩" FontSize="18" TextWrapping="Wrap" Margin="0,18,0,8"/><TextBlock x:Name="MediaSubtitle" Text="分析連結後，預覽影片資訊與可選格式。" Foreground="#8FA5C3" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <TextBlock x:Name="MetadataLabel" Foreground="#AABDE0" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="下載格式" FontSize="16"/><Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Mp4Button" Content="▣ 影片 MP4" Padding="6,11" Background="{StaticResource Accent}" Click="Mp4Click"/><Button Grid.Column="1" x:Name="Mp3Button" Content="♫ 音訊 MP3" Padding="6,11" Click="Mp3Click"/></Grid>
    <TextBlock Text="畫質 / 音質選擇"/><ComboBox x:Name="QualityBox" SelectedValuePath="Value" SelectionChanged="QualityChanged"/><TextBlock x:Name="EstimateLabel" Foreground="#AABDE0" FontSize="13" TextWrapping="Wrap" Margin="4,0,4,10"/><TextBlock x:Name="DirectoryLabel" Text="MP4 儲存位置" Margin="0,16,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox" IsReadOnly="True" FontSize="13" MinHeight="44" MaxHeight="80" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Grid.Column="1" Content="瀏覽" Padding="6" Click="BrowseClick"/></Grid><Button Content="↓　開始下載" Background="{StaticResource Accent}" FontSize="19" Padding="12,17" Margin="3,14,3,0" Click="DownloadClick"/>
    <TextBlock x:Name="StatusLabel" Text="" TextWrapping="Wrap" Foreground="#91A9CD" Margin="3,12"/><TextBlock Text="MP3 最高雙聲道；320 kbps 不會提升來源本身音質。" TextWrapping="Wrap" FontSize="12" Foreground="#6E85A6" Margin="3,12"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</Window>
