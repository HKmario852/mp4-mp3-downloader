<Window x:Class="Omni.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:System="clr-namespace:System;assembly=System.Runtime" xmlns:local="clr-namespace:Omni.Windows" Title="全能影音下載器" Icon="/App;component/Assets/omni.ico" Width="1440" Height="940" MinWidth="860" MinHeight="700" Background="{DynamicResource Ink}" Foreground="{DynamicResource Text}" FontFamily="Microsoft JhengHei UI" FontSize="15" WindowStartupLocation="CenterScreen">
