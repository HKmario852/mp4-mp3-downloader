 </Window.Resources>
 <Grid x:Name="AppRoot" Margin="12"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="14,2"><Image Source="/App;component/Assets/brand.png" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="全能影音下載器圖示"/><TextBlock Text="全能影音下載器" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="　OMNI / 0.2.4" Foreground="#7186A4" FontSize="11" VerticalAlignment="Center"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="NavColumn" Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="380"/></Grid.ColumnDefinitions>
   <Border x:Name="MainNav" Style="{StaticResource Panel}" Padding="9"><DockPanel><StackPanel x:Name="NavFooter" DockPanel.Dock="Bottom" Margin="12"><TextBlock Text="你的媒體，井然有序" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="SpaceLabel" Text="" Foreground="{DynamicResource Text}" Margin="0,12,0,0"/></StackPanel><StackPanel><Button x:Name="NewNav" Content="＋　新增下載" Background="{StaticResource Accent}" Click="NewClick"/><Button x:Name="QueueNav" Content="↓　下載中" Background="Transparent" Click="QueueClick" Margin="3,15,3,3"/><Button x:Name="HistoryNav" Content="✓　已下載" Background="Transparent" Click="HistoryClick"/><Button x:Name="TagsNav" Content="♫　標籤編輯" Background="Transparent" Click="TagsClick"/><Button x:Name="SettingsNav" Content="⚙　設定" Background="Transparent" Click="SettingsClick"/><Button x:Name="CollapseNav" Content="☰" Background="Transparent" Click="CollapseClick"/></StackPanel></DockPanel></Border>
   <Grid Grid.Column="1" x:Name="DownloadArea"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Padding="12" MinHeight="94"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="UrlBox" Text="" MinHeight="56" MaxHeight="140" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" TextChanged="UrlChanged" AutomationProperties.Name="貼上影片連結" ToolTip="貼上 HTTPS 影片連結"/><TextBlock Text="貼上 YouTube 或其他影片網址…" Margin="16,10" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="分析連結" Background="{StaticResource Accent}" Click="AnalyzeClick"/></Grid></Border>
    <Border Grid.Row="1" Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock x:Name="PageTitle" Text="下載任務" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Foreground="{DynamicResource Muted}" Margin="12,5"/></DockPanel>
     <DockPanel Grid.Row="1" Margin="0,10"><Button DockPanel.Dock="Right" x:Name="ClearButton" Content="清空歷史" Click="ClearClick" Visibility="Collapsed"/><ComboBox x:Name="FormatFilter" DockPanel.Dock="Left" Width="135" SelectedIndex="0" SelectionChanged="FilterChanged" Visibility="Collapsed" AutomationProperties.Name="已下載格式篩選"><System:String>全部格式</System:String><System:String>MP3</System:String><System:String>MP4</System:String></ComboBox><Grid><TextBox x:Name="SearchBox" TextChanged="SearchChanged"  AutomationProperties.Name="搜尋標題、網址、檔名、歌手、專輯"/><TextBlock Text="搜尋下載任務：標題、歌手、專輯、網址或檔名…" Margin="16,10" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
     <Grid Grid.Row="2"><DataGrid x:Name="JobGrid" SelectionChanged="SelectionChanged" MouseDoubleClick="FileDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="標題" Binding="{Binding Title}" Width="*" MinWidth="140"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="65"/><DataGridTextColumn Header="畫質 / 音質" Binding="{Binding Quality}" Width="100"/><DataGridTemplateColumn Header="狀態" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="#6A95FF"/><ProgressBar Value="{Binding Progress}" Height="4" Maximum="100" Margin="0,8,12,0" Foreground="#735DFF" Background="#304360"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85"/></DataGrid.Columns></DataGrid>
      <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="↓" FontSize="56" Foreground="#566C92" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="將喜歡的影音收藏到這裡" FontSize="21" Margin="0,15,0,8" HorizontalAlignment="Center"/><TextBlock Text="貼上連結，選擇格式，即可開始下載" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Grid>
     <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="⏸ 暫停" Click="PauseClick"/><Button Content="▶ 繼續" Click="ResumeClick"/><Button x:Name="RemoveQueueButton" Content="移除" Click="CancelClick"/><Button x:Name="FailedButton" Content="失敗任務" Click="FailedClick"/><Button x:Name="DeleteFileButton" Content="刪除所選檔案" Click="DeleteFileClick" Visibility="Collapsed"/><Button Visibility="Collapsed" x:Name="EditTagsButton" Content="編輯所選標籤" Click="EditTagsClick"/><Button Visibility="Collapsed" x:Name="FolderButton" Content="開啟檔案位置" Click="FolderClick"/><Button Content="診斷" Click="ErrorClick"/></WrapPanel>
    </Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" x:Name="GroupsPanel" MaxHeight="220" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GroupCards"/></ScrollViewer></Border>
    <Border Grid.Row="3" Style="{StaticResource Panel}" x:Name="RecentPanel"><StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="查看全部 ›" Click="HistoryClick" Background="Transparent" BorderBrush="Transparent" Padding="3"/><TextBlock Text="最近下載" FontSize="20" FontWeight="SemiBold"/></DockPanel><DataGrid x:Name="RecentGrid" Height="175" RowHeight="44" SelectionChanged="RecentSelected" MouseDoubleClick="FileDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="標題" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="70"/><DataGridTextColumn Header="畫質 / 音質" Binding="{Binding Quality}" Width="110"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="95"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   </Grid>
   <Border Grid.Column="2" x:Name="Details" Style="{StaticResource Panel}" Padding="0"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ScrollViewer.Resources><StackPanel Margin="20,18,16,16"><TextBlock Text="下載設定" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/><Border Height="192" Background="{DynamicResource Ink}" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock Text="▶" FontSize="50" Foreground="#778DF0" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="Thumbnail" Stretch="Uniform"/></Grid></Border><TextBlock x:Name="MediaTitle" Text="準備好下一段精彩" FontSize="18" TextWrapping="Wrap" Margin="0,18,0,8"/><TextBlock x:Name="MediaSubtitle" Text="分析連結後，預覽影片資訊與可選格式。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
    <TextBlock x:Name="MetadataLabel" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="下載格式" FontSize="16"/><Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Mp4Button" Content="▣ 影片 MP4" Padding="6,11" Background="{StaticResource Accent}" Click="Mp4Click"/><Button Grid.Column="1" x:Name="Mp3Button" Content="♫ 音訊 MP3" Padding="6,11" Click="Mp3Click"/></Grid>
    <TextBlock Text="畫質 / 音質選擇"/><ComboBox x:Name="QualityBox" SelectedValuePath="Value" SelectionChanged="QualityChanged"/><TextBlock x:Name="EstimateLabel" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="4,0,4,10"/><TextBlock x:Name="DirectoryLabel" Text="MP4 儲存位置" Margin="0,16,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryBox" IsReadOnly="True" FontSize="13" MinHeight="44" MaxHeight="80" Padding="8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Grid.Column="1" Content="瀏覽" Padding="6" Click="BrowseClick"/></Grid><Button Content="↓　開始下載" Background="{StaticResource Accent}" FontSize="19" Padding="12,17" Margin="3,14,3,0" Click="DownloadClick"/>
    <TextBlock x:Name="StatusLabel" Text="" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="3,12"/><TextBlock Text="MP3 最高雙聲道；320 kbps 不會提升來源本身音質。" TextWrapping="Wrap" FontSize="12" Foreground="#6E85A6" Margin="3,12"/>
   </StackPanel></ScrollViewer></Border>
   <ContentControl x:Name="PageHost" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</Window>
